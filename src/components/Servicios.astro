---
/**
 * Servicios: sección oscura con tarjetas de vidrio. Cada tarjeta muestra una vista del trabajo:
 * inventario (UI en HTML), automatización (línea de tiempo en HTML), web y apps (captura real del
 * sitio de Ferre Vertikal G&L) e identidad (tablero de marca de Ferre Vertikal con su logo real).
 */
import Icon from './Icon.astro';
import { servicios, consultoria } from '../data/contenido';
const iconos: Record<string, string> = { gestion: 'box', automatizacion: 'repeat', software: 'code', identidad: 'pen' };
const filas = [
  { n: 'Cemento 50 kg', c: '1.250', p: '$8,90', ok: true },
  { n: 'Varilla 12 mm', c: '860', p: '$12,40', ok: true },
  { n: 'Tubo PVC ½"', c: '18', p: '$3,20', ok: false },
  { n: 'Pintura blanca', c: '4', p: '$24,00', ok: false },
  { n: 'Cable #12', c: '340', p: '$0,85', ok: true },
];
const pasos = ['Pedido recibido', 'Asignado a transporte', 'Correo automático al cliente', 'Despacho directo a la obra'];
---
<section class="section svc-sec on-dark" id="servicios" aria-labelledby="svc-titulo">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">Servicios</p>
      <h2 id="svc-titulo">Lo que hacemos por tu negocio</h2>
      <p class="sec-intro">Cuatro servicios que se combinan entre sí.</p>
    </header>

    <ul role="list" class="svc-grid">
      {servicios.map((s, i) => (
        <li class={`svc svc--${s.visual}`} style={`--i:${i}`}>
          <div class="svc__vista" aria-hidden="true">
            {s.visual === 'gestion' && (
              <div class="v-app">
                <div class="v-app__side"><i class="on"></i><i></i><i></i><i></i><i></i></div>
                <div class="v-app__main">
                  <div class="v-app__top"><b>Inventario</b><span>+ Producto</span></div>
                  <div class="v-app__thead"><span>Producto</span><span>Cant.</span><span>Precio</span><span>Estado</span></div>
                  {filas.map((f, k) => (
                    <div class="v-app__fila" style={`--k:${k}`}>
                      <span><i class={`thumb t${k}`}></i>{f.n}</span><span>{f.c}</span><span>{f.p}</span>
                      <span class={f.ok ? 'ok' : 'bajo'}>{f.ok ? 'En stock' : 'Reponer'}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {s.visual === 'automatizacion' && (
              <div class="v-flujo">
                <p class="v-flujo__t">Pedidos en tiempo real</p>
                <ol role="list">
                  {pasos.map((p, k) => <li style={`--k:${k}`}><i></i>{p}</li>)}
                </ol>
                <div class="v-mapa"><span class="v-mapa__pin"></span></div>
              </div>
            )}

            {s.visual === 'software' && (
              <div class="v-disp">
                <div class="v-laptop">
                  <div class="v-laptop__pant">
                    <img src="/img/proyecto-ferre-web-640.webp" srcset="/img/proyecto-ferre-web-640.webp 640w, /img/proyecto-ferre-web-1024.webp 1024w" sizes="320px" width="640" height="301" alt="" loading="lazy" decoding="async" />
                  </div>
                  <div class="v-laptop__base"></div>
                </div>
                <div class="v-cel">
                  <div class="m-web">
                    <div class="m-web__nav"><img src="/clientes/ferre-vertikal-gl.webp" width="480" height="222" alt="" loading="lazy" decoding="async" /><i class="m-web__menu"></i></div>
                    <div class="m-web__hero">
                      <b class="m-web__t">Todo para tu obra, <span>en un solo lugar.</span></b>
                      <p>Cemento, hierro, cubiertas y herramientas con stock real.</p>
                      <div class="m-web__buscar"><span>¿Qué necesitas?</span><i>Buscar</i></div>
                      <div class="m-web__cifras"><span><b>8</b>categorías</span><span><b>500+</b>productos</span><span><b>24 h</b>entrega</span></div>
                      <div class="m-web__cats"><span><i></i>Cemento</span><span><i></i>Hierro</span><span><i></i>Tubería</span><span><i></i>Eléctricos</span></div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {s.visual === 'identidad' && (
              <div class="v-marca">
                <div class="v-marca__logo"><img src="/clientes/ferre-vertikal-gl.webp" width="480" height="222" alt="" loading="lazy" decoding="async" /></div>
                <div class="v-marca__paleta"><i style="background:#FF6A0D"></i><i style="background:#1C282F"></i><i style="background:#6D6E71"></i><i style="background:#FFFFFF"></i></div>
                <div class="v-marca__post"><b>Todo para tu obra</b><span>Cemento, hierro y pinturas</span></div>
                <div class="v-marca__post v-marca__post--b"><b>-20%</b><span>en herramientas</span></div>
              </div>
            )}
          </div>

          <span class="svc__ico"><Icon name={iconos[s.visual]} /></span>
          <div class="svc__txt">
            <p class="svc__meta">{s.linea}</p>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="consult">
      <p><b>{consultoria.titulo}</b> {consultoria.texto}</p>
      <button type="button" class="btn btn--primario" data-abrir-agenda>Agendar diagnóstico <Icon name="arrow" /></button>
    </div>
  </div>
</section>

<style>
  .svc-sec {
    position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(60% 50% at 80% 0%, color-mix(in oklab, var(--c-verde) 45%, transparent), transparent 70%),
      radial-gradient(40% 40% at 10% 100%, color-mix(in oklab, var(--c-coral) 12%, transparent), transparent 70%),
      var(--c-tinta);
    color: var(--c-blanco);
  }
  .svc-sec::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background-image: radial-gradient(color-mix(in oklab, var(--c-menta) 14%, transparent) 1px, transparent 1.4px);
    background-size: 26px 26px;
    mask-image: radial-gradient(80% 70% at 60% 40%, #000 20%, transparent 80%);
  }
  .svc-sec .sec-intro { color: var(--c-texto-osc-suave); }

  .svc-grid { display: grid; gap: var(--col-gap); grid-template-columns: 1fr; }
  .svc {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; align-content: end; min-height: 380px;
    padding: 22px 22px 26px; border-radius: 20px;
    background: linear-gradient(160deg, color-mix(in oklab, var(--c-tinta-2) 92%, var(--c-blanco)) 0%, color-mix(in oklab, var(--c-tinta) 70%, #000) 100%);
    border: 1px solid color-mix(in oklab, var(--c-menta) 16%, transparent);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.04), 0 30px 60px -40px rgb(0 0 0 / 0.8);
    transition: transform var(--dur-2) var(--ease-out), border-color var(--dur-2), box-shadow var(--dur-2);
  }
  .svc:hover { transform: translateY(-4px); border-color: color-mix(in oklab, var(--c-menta) 45%, transparent); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 30px 60px -30px color-mix(in oklab, var(--c-verde) 70%, transparent); }

  /* Vista del trabajo: arriba a la derecha, se funde hacia el texto */
  .svc__vista {
    position: absolute; z-index: -1; top: 0; right: 0; width: 74%; height: 50%;
    -webkit-mask-image: linear-gradient(200deg, #000 50%, transparent 95%);
    mask-image: linear-gradient(200deg, #000 50%, transparent 95%);
    transition: transform 700ms var(--ease-out);
  }
  .svc:hover .svc__vista { transform: scale(1.04) translate(-4px, 2px); }

  .svc__ico {
    position: absolute; top: 22px; left: 22px; width: 54px; height: 54px; border-radius: 16px;
    display: grid; place-items: center; color: var(--c-menta);
    background: color-mix(in oklab, var(--c-verde) 35%, var(--c-tinta));
    border: 1px solid color-mix(in oklab, var(--c-menta) 35%, transparent);
    box-shadow: 0 0 24px -4px color-mix(in oklab, var(--c-menta) 45%, transparent), inset 0 1px 0 rgb(255 255 255 / 0.08);
  }
  .svc__txt { display: grid; gap: 8px; }
  .svc__meta { font-family: var(--f-mono); font-size: var(--t-label); color: var(--c-menta); }
  .svc h3 { font-size: 1.3rem; line-height: 1.2; }
  .svc__txt > p:last-child { color: var(--c-texto-osc-suave); font-size: 0.9375rem; line-height: 1.55; }

  /* ——— 1. Inventario ——— */
  .v-app { position: absolute; inset: 12px 0 0 0; display: grid; grid-template-columns: 26px 1fr; border-radius: 12px 0 0 0; overflow: hidden; background: #0f1a1c; border: 1px solid rgb(255 255 255 / 0.06); font-size: 7.5px; color: rgb(255 255 255 / 0.85); }
  .v-app__side { background: #0b1314; display: grid; align-content: start; gap: 7px; padding: 10px 7px; }
  .v-app__side i { height: 4px; border-radius: 2px; background: rgb(255 255 255 / 0.15); }
  .v-app__side i.on { background: var(--c-coral); }
  .v-app__main { padding: 8px 10px; display: grid; align-content: start; gap: 4px; }
  .v-app__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px; }
  .v-app__top b { font-size: 9px; font-weight: 600; }
  .v-app__top span { background: var(--c-coral); color: var(--c-tinta); padding: 2px 6px; border-radius: 4px; font-weight: 600; }
  .v-app__thead, .v-app__fila { display: grid; grid-template-columns: 2fr 0.7fr 0.8fr 1.1fr; gap: 5px; align-items: center; }
  .v-app__thead { color: rgb(255 255 255 / 0.45); padding: 2px 0; }
  .v-app__fila { padding: 4px 0; border-top: 1px solid rgb(255 255 255 / 0.06); }
  .v-app__fila > span:first-child { display: flex; align-items: center; gap: 5px; white-space: nowrap; }
  .thumb { width: 11px; height: 11px; border-radius: 3px; flex: none; }
  .t0 { background: #b8b2a7; } .t1 { background: #6f7c86; } .t2 { background: #e9e9e9; } .t3 { background: #f2efe6; } .t4 { background: #d1473a; }
  .ok, .bajo { justify-self: start; padding: 1px 5px; border-radius: 99px; font-weight: 600; white-space: nowrap; }
  .ok { background: color-mix(in oklab, var(--c-menta) 25%, transparent); color: var(--c-menta); }
  .bajo { background: color-mix(in oklab, var(--c-coral) 25%, transparent); color: var(--c-coral); }

  /* ——— 2. Automatización ——— */
  .v-flujo { position: absolute; inset: 12px 0 0 0; padding: 10px 12px; border-radius: 12px 0 0 0; background: #f6faf8; color: var(--c-tinta); font-size: 8px; display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: auto 1fr; gap: 6px 8px; }
  .v-flujo__t { grid-column: 1 / -1; font-weight: 600; font-size: 9px; }
  .v-flujo ol { display: grid; gap: 7px; align-content: start; position: relative; }
  .v-flujo ol::before { content: ''; position: absolute; left: 5px; top: 6px; bottom: 6px; width: 1.5px; background: color-mix(in oklab, var(--c-verde) 30%, transparent); }
  .v-flujo li { position: relative; display: flex; align-items: center; gap: 7px; }
  .v-flujo li i { width: 11px; height: 11px; border-radius: 50%; flex: none; background: var(--c-verde); box-shadow: 0 0 0 2px #f6faf8; position: relative; }
  .v-flujo li i::after { content: ''; position: absolute; left: 3.5px; top: 2px; width: 3px; height: 5px; border: solid #fff; border-width: 0 1.5px 1.5px 0; transform: rotate(45deg); }
  .v-mapa { border-radius: 8px; position: relative; overflow: hidden;
    background: linear-gradient(90deg, transparent 47%, #fff 47% 53%, transparent 53%), linear-gradient(0deg, transparent 47%, #fff 47% 53%, transparent 53%), linear-gradient(35deg, transparent 46%, #fff 46% 52%, transparent 52%), #dfeae5; }
  .v-mapa__pin { position: absolute; left: 50%; top: 40%; width: 12px; height: 12px; translate: -50% -50%; border-radius: 50% 50% 50% 0; rotate: -45deg; background: var(--c-coral); }

  /* ——— 3. Web y apps ——— */
  .v-disp { position: absolute; inset: 0; }
  .v-laptop { position: absolute; right: 18px; top: 18px; width: 78%; }
  .v-laptop__pant { padding: 4px; border-radius: 8px 8px 0 0; background: #0d1416; border: 1px solid rgb(255 255 255 / 0.1); }
  .v-laptop__pant img { display: block; width: 100%; height: auto; border-radius: 4px; }
  .v-laptop__base { height: 6px; margin: 0 -6%; border-radius: 0 0 8px 8px; background: linear-gradient(#5d7174, #2a3b3e); }
  .v-cel { position: absolute; right: 6px; top: 20%; width: min(30%, 68px); aspect-ratio: 9 / 18; border-radius: 12px; overflow: hidden; border: 3px solid #0d1416; background: #1c282f; box-shadow: 0 10px 20px -8px rgb(0 0 0 / 0.7); container-type: inline-size; }
  /* Versión móvil de la web de Ferre Vertikal, maquetada al ancho del teléfono */
  .m-web { height: 100%; display: grid; grid-template-rows: auto 1fr; font-family: 'Open Sans', var(--f-body); }
  .m-web__nav { display: flex; align-items: center; justify-content: space-between; padding: 4cqw 6cqw; background: #fff; }
  .m-web__nav img { width: 38cqw; height: auto; }
  .m-web__menu { width: 9cqw; height: 6cqw; background: linear-gradient(#1c282f 0 0) top / 100% 1.2cqw no-repeat, linear-gradient(#1c282f 0 0) center / 100% 1.2cqw no-repeat, linear-gradient(#1c282f 0 0) bottom / 100% 1.2cqw no-repeat; }
  .m-web__hero {
    display: grid; align-content: start; gap: 4.5cqw; padding: 10cqw 6cqw 6cqw; color: #fff;
    background: linear-gradient(180deg, rgb(20 28 32 / 0.82), rgb(20 28 32 / 0.95)), url('/img/proyecto-ferre-web-640.webp') 78% 60% / auto 140% no-repeat, #1c282f;
  }
  .m-web__t { font-size: 10.5cqw; font-weight: 800; line-height: 1.08; letter-spacing: -0.02em; }
  .m-web__t span { display: block; color: #FF6A0D; }
  .m-web__hero p { font-size: 4.6cqw; line-height: 1.4; color: rgb(255 255 255 / 0.82); }
  .m-web__buscar { display: flex; align-items: center; justify-content: space-between; gap: 2cqw; padding: 1.5cqw 1.5cqw 1.5cqw 4cqw; border-radius: 99px; background: #fff; color: #6D6E71; font-size: 4.2cqw; }
  .m-web__buscar i { font-style: normal; font-weight: 700; color: #fff; background: #FF6A0D; padding: 2cqw 4cqw; border-radius: 99px; }
  .m-web__cifras { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqw; padding-top: 3cqw; border-top: 1px solid rgb(255 255 255 / 0.12); font-size: 3.6cqw; color: rgb(255 255 255 / 0.6); }
  .m-web__cifras b { display: block; font-size: 6cqw; font-weight: 800; color: #fff; }
  .m-web__cats { display: grid; grid-template-columns: 1fr 1fr; gap: 3cqw; margin-top: 2cqw; }
  .m-web__cats span { display: grid; gap: 2.5cqw; padding: 4cqw; border-radius: 3cqw; background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.08); font-size: 4cqw; font-weight: 600; }
  .m-web__cats i { width: 8cqw; height: 8cqw; border-radius: 2cqw; background: #FF6A0D; }
  .m-web__cats span:nth-child(2) i { background: #6D6E71; } .m-web__cats span:nth-child(3) i { background: #fff; } .m-web__cats span:nth-child(4) i { background: color-mix(in oklab, #FF6A0D 60%, #fff); }

  /* ——— 4. Identidad ——— */
  .v-marca { position: absolute; inset: 12px 0 0 12px; display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: 1fr 1fr; gap: 6px; }
  .v-marca__logo { border-radius: 8px; background: #fff; display: grid; place-items: center; padding: 6px; }
  .v-marca__logo img { width: 100%; height: auto; }
  .v-marca__paleta { display: grid; grid-template-columns: repeat(2, 1fr); gap: 4px; }
  .v-marca__paleta i { border-radius: 6px; border: 1px solid rgb(255 255 255 / 0.12); }
  .v-marca__post { border-radius: 8px; background: #1c282f; color: #fff; padding: 8px; display: grid; align-content: end; gap: 2px; font-size: 7.5px; border-left: 3px solid #FF6A0D; }
  .v-marca__post b { font-size: 10px; font-weight: 600; color: #FF6A0D; line-height: 1.1; }
  .v-marca__post--b { background: #FF6A0D; border-left-color: #1C282F; }
  .v-marca__post--b b { color: #1C282F; font-size: 16px; }
  .v-marca__post--b span { color: #1C282F; font-weight: 600; }

  /* Motion */
  @media (prefers-reduced-motion: no-preference) {
    .v-app__fila { animation: fila-luz 5s ease-in-out infinite; animation-delay: calc(var(--k) * 0.5s); }
    .v-flujo li { animation: paso-on 4.8s ease-in-out infinite; animation-delay: calc(var(--k) * 0.6s); }
    .v-mapa__pin { animation: pin 1.6s ease-in-out infinite; }
    .v-laptop, .v-cel { animation: flota-d 5s var(--ease-in-out) infinite alternate; }
    .v-cel { animation-delay: -2.5s; }
    .v-marca__paleta i { animation: muestra 3s ease-in-out infinite; }
    .v-marca__paleta i:nth-child(2) { animation-delay: .3s; } .v-marca__paleta i:nth-child(3) { animation-delay: .6s; } .v-marca__paleta i:nth-child(4) { animation-delay: .9s; }
    .svc__ico { animation: ico-luz 3.6s ease-in-out infinite; animation-delay: calc(var(--i) * 0.5s); }
  }
  @keyframes fila-luz { 0%, 70%, 100% { background: transparent; } 80% { background: rgb(255 255 255 / 0.06); } }
  @keyframes paso-on { 0%, 8% { opacity: 0.35; } 18%, 100% { opacity: 1; } }
  @keyframes pin { 50% { translate: -50% -80%; } }
  @keyframes flota-d { to { transform: translateY(-5px); } }
  @keyframes muestra { 50% { transform: scale(0.9); } }
  @keyframes ico-luz { 50% { box-shadow: 0 0 34px 0 color-mix(in oklab, var(--c-menta) 55%, transparent), inset 0 1px 0 rgb(255 255 255 / 0.08); } }

  /* Consultoría */
  .consult {
    margin-top: var(--col-gap);
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px;
    padding: 20px 20px 20px 28px; border-radius: 20px;
    background: color-mix(in oklab, var(--c-verde) 22%, transparent);
    border: 1px solid color-mix(in oklab, var(--c-menta) 45%, transparent);
    box-shadow: 0 0 40px -18px color-mix(in oklab, var(--c-menta) 60%, transparent);
  }
  .consult p { max-width: 70ch; color: var(--c-blanco); }
  .consult b { font-weight: 500; }
  .consult .btn--primario { --btn-bg: var(--c-menta); --btn-fg: var(--c-tinta); }
  .consult .btn--primario:hover { --btn-bg: var(--c-blanco); }

  @media (min-width: 700px) { .svc-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1100px) { .svc-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 639px) { .consult .btn { width: 100%; } .consult { padding: 22px; } .svc { min-height: 360px; } }
</style>
