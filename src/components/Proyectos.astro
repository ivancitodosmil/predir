---
import Icon from './Icon.astro';
import { proyectos, clientes } from '../data/contenido';
import { whatsappLink } from '../config/site';
const mitad = Math.ceil(clientes.length / 2);
const filaA = clientes.slice(0, mitad);
const filaB = clientes.slice(mitad);
const waCaso = whatsappLink('Hola Predir, quiero que mi negocio sea su próximo caso. ¿Podemos conversar?');
---
<section class="section" id="proyectos" aria-labelledby="proy-titulo">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">Proyectos y clientes</p>
      <h2 id="proy-titulo">Negocios que ya trabajan con nosotros</h2>
      <p class="sec-intro">Empresas y emprendimientos de Loja que confiaron en PREDIR para ordenar, digitalizar o renovar su imagen.</p>
    </header>

    <!-- Clientes: espacios reservados hasta recibir los logotipos reales y su autorización -->
    <div class="clientes on-dark">
      <div class="clientes__txt">
        <p class="label">Clientes</p>
        <h3>Tu negocio puede ser el siguiente</h3>
        <p>Conversemos sobre lo que quieres mejorar y te proponemos una solución a tu medida.</p>
        {waCaso && <a class="btn btn--primario" href={waCaso} target="_blank" rel="noopener">Quiero ser el próximo caso <Icon name="arrow" /></a>}
      </div>
      <!-- Dos cintas de logos en movimiento (sentidos opuestos). La primera copia es la accesible; las demás, decorativas. -->
      <div class="cintas">
        {[filaA, filaB].map((fila, f) => (
          <div class={`cinta-logos ${f === 1 ? 'cinta-logos--inv' : ''}`}>
            <div class="cinta-logos__pista">
              {[0, 1, 2, 3].map((copia) => (
                <ul role="list" class="cinta-logos__grupo" aria-hidden={copia > 0 ? 'true' : undefined}>
                  {fila.map((c) => (
                    <li class="logo logo--real" style={`--fondo:${c.fondo}`}><img src={c.logo} alt={copia === 0 ? c.nombre : ''} width={c.ancho} height={c.alto} loading="lazy" decoding="async" /></li>
                  ))}
                </ul>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    {proyectos.length > 0 && (
    <ul role="list" class="casos">
      {proyectos.map((p) => (
        <li class="caso">
          <div class="caso__img"><img src={p.imagen} alt={`${p.titulo} para ${p.cliente}`} loading="lazy" decoding="async" width="800" height="600" /></div>
          <div class="caso__txt">
            <p class="caso__meta">{p.cliente} · {p.sector}</p>
            <h3>{p.titulo}</h3>
            <dl>
              <div><dt>Problema</dt><dd>{p.problema}</dd></div>
              <div><dt>Solución</dt><dd>{p.solucion}</dd></div>
              <div><dt>Resultado</dt><dd>{p.resultado}</dd></div>
            </dl>
          </div>
        </li>
      ))}

    </ul>
    )}
  </div>
</section>

<style>
  /* ——— Clientes ——— */
  .clientes {
    position: relative; overflow: hidden; isolation: isolate;
    display: grid; gap: 32px;
    padding: clamp(28px, 4vw, 56px);
    margin-bottom: var(--col-gap);
    border-radius: var(--r-l);
    background: var(--c-tinta); color: var(--c-blanco);
  }
  .clientes::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background-image: radial-gradient(color-mix(in oklab, var(--c-menta) 20%, transparent) 1px, transparent 1.4px);
    background-size: 24px 24px;
    mask-image: radial-gradient(70% 90% at 85% 50%, #000 10%, transparent 70%);
  }
  .clientes__txt { display: grid; gap: 16px; justify-items: start; align-content: start; }
  .clientes__txt h3 { font-size: var(--t-h3); }
  .clientes__txt > p:not(.label) { color: var(--c-texto-osc-suave); max-width: 40ch; }
  .clientes__lista { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .logo {
    position: relative; height: 112px; display: grid; place-items: center; padding: 20px;
    border-radius: var(--r-m);
    background: color-mix(in oklab, var(--c-blanco) 4%, transparent);
    border: 1px solid var(--c-linea-osc);
    transition: border-color var(--dur-2), background-color var(--dur-2), transform var(--dur-2) var(--ease-out);
  }
  .logo:hover { transform: translateY(-2px); border-color: color-mix(in oklab, var(--c-menta) 50%, transparent); }
  /* Logos reales: sobre blanco y con sus colores originales (respeto a la marca del cliente) */
  .logo--real { height: auto; aspect-ratio: 2 / 1; padding: 0; overflow: hidden; background: var(--fondo); border-color: color-mix(in oklab, var(--c-blanco) 10%, transparent); }
  .logo--real img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: transform 500ms var(--ease-out); }
  .logo--real:hover img { transform: scale(1.04); }
  .logo--real:hover { box-shadow: 0 16px 32px -18px rgb(0 0 0 / 0.6); }
  .logo--hueco { border-style: dashed; border-color: color-mix(in oklab, var(--c-menta) 26%, transparent); }
  .logo__prox { display: inline-flex; align-items: center; gap: 8px; font-family: var(--f-mono); font-size: 0.75rem; color: color-mix(in oklab, var(--c-menta) 70%, transparent); transition: color var(--dur-2); }
  .logo--hueco:hover .logo__prox { color: var(--c-menta); }
  .clientes__nota { justify-self: start; }

  /* Cintas de logos */
  .cintas { display: grid; gap: 14px; min-width: 0; overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .cinta-logos { overflow: hidden; }
  .cinta-logos__pista { display: flex; width: max-content; }
  .cinta-logos__grupo { display: flex; gap: 14px; padding-right: 14px; }
  .cinta-logos .logo { width: clamp(170px, 18vw, 230px); flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    .cinta-logos__pista { animation: cinta-logos 26s linear infinite; }
    .cinta-logos--inv .cinta-logos__pista { animation-direction: reverse; animation-duration: 30s; }
    .cintas:hover .cinta-logos__pista { animation-play-state: paused; }
  }
  @keyframes cinta-logos { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .cinta-logos__grupo[aria-hidden] { display: none; } .cinta-logos__pista { width: auto; } .cinta-logos__grupo { flex-wrap: wrap; } }
  @media (min-width: 1024px) {
    .clientes { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); align-items: center; }
    .clientes__txt { grid-column: 1 / span 4; }
    .cintas { grid-column: 6 / -1; }
  }
  @media (max-width: 639px) { .clientes__txt .btn { width: 100%; } }

  /* ——— Casos ——— */
  .casos { display: grid; gap: var(--col-gap); }
  .caso {
    display: grid; border-radius: var(--r-l); overflow: hidden;
    background: var(--c-blanco); border: 1px solid var(--c-linea);
  }
  .caso__img { position: relative; aspect-ratio: 4 / 3; background: var(--c-papel-2); display: grid; place-items: center; overflow: hidden; }
  .caso__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out); }
  .caso:hover .caso__img img { transform: scale(1.025); }
  .caso__txt { padding: 24px 24px 28px; display: grid; gap: 14px; }
  .caso__meta { font-family: var(--f-mono); font-size: var(--t-label); color: var(--c-verde); }
  .caso h3 { font-size: 1.375rem; }
  .caso dl { display: grid; gap: 12px; }
  .caso dt { font-family: var(--f-mono); font-size: 0.75rem; color: var(--c-texto-suave); margin-bottom: 4px; }
  .caso dd { font-size: 0.9375rem; }

  @media (min-width: 1024px) { .casos { grid-template-columns: repeat(3, 1fr); } }
</style>
