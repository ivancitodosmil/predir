---
/**
 * Imagen responsiva de /public/img/<nombre>-<ancho>.webp (640, 1024, 1536).
 * Las imágenes son originales generadas con IA (ver recursos/LEEME.txt): sin texto ni logos.
 */
interface Props {
  nombre: string;
  alt?: string; // vacío = decorativa
  sizes?: string;
  class?: string;
  eager?: boolean;
  ancho?: number;
  alto?: number;
}
const { nombre, alt = '', sizes = '100vw', class: cls, eager = false, ancho = 1536, alto = 1024 } = Astro.props;
const src = (w: number) => `/img/${nombre}-${w}.webp`;
---
<img
  class={cls}
  src={src(1024)}
  srcset={`${src(640)} 640w, ${src(1024)} 1024w, ${src(1536)} 1536w`}
  sizes={sizes}
  width={ancho}
  height={alto}
  alt={alt}
  aria-hidden={alt ? undefined : 'true'}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
/>
