---
/**
 * Ventana para agendar un diagnóstico (visita al negocio).
 * Se abre con cualquier elemento [data-abrir-agenda].
 * Envío: POST JSON a PUBLIC_FORM_ENDPOINT (+ access_key de Web3Forms si existe) → llega al correo.
 * Sin endpoint NO simula el envío: lo dice y ofrece mandarlo por WhatsApp con los datos ya escritos.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';
const { formEndpoint, formAccessKey, whatsapp, email } = site.contact;
const horas = ['08:00', '09:00', '10:00', '11:00', '12:00', '14:00', '15:00', '16:00', '17:00'];
const giros = ['Ferretería / materiales', 'Tienda / comercio', 'Distribuidora', 'Restaurante / alimentos', 'Salud / consultorio', 'Servicios profesionales', 'Educación', 'Otro'];
---
<dialog class="agenda" aria-labelledby="agenda-titulo" data-agenda>
  <form
    class="agenda__form"
    novalidate
    data-agenda-form
    data-endpoint={formEndpoint}
    data-key={formAccessKey}
    data-whatsapp={whatsapp}
    data-email={email}
  >
    <header class="agenda__head">
      <div>
        <p class="label">Diagnóstico sin costo</p>
        <h2 id="agenda-titulo">Agenda una visita a tu negocio</h2>
        <p class="agenda__intro">Vamos a conocer cómo trabajas hoy y te decimos qué conviene digitalizar primero.</p>
      </div>
      <button type="button" class="agenda__cerrar" data-cerrar-agenda aria-label="Cerrar"><Icon name="close" /></button>
    </header>

    <div class="agenda__grid">
      <div class="campo">
        <label for="a-empresa">Empresa o negocio <span aria-hidden="true">*</span></label>
        <input id="a-empresa" name="empresa" type="text" autocomplete="organization" required minlength="2" aria-describedby="ae-empresa" />
        <p class="campo__error" id="ae-empresa" data-error-for="empresa"></p>
      </div>
      <div class="campo">
        <label for="a-giro">¿A qué se dedica? <span aria-hidden="true">*</span></label>
        <input id="a-giro" name="giro" type="text" list="a-giros" required minlength="3" placeholder="Ej.: ferretería, distribuidora…" aria-describedby="ae-giro" />
        <datalist id="a-giros">{giros.map((g) => <option value={g} />)}</datalist>
        <p class="campo__error" id="ae-giro" data-error-for="giro"></p>
      </div>
      <div class="campo campo--ancho">
        <label for="a-ubicacion">Ubicación <span aria-hidden="true">*</span></label>
        <input id="a-ubicacion" name="ubicacion" type="text" autocomplete="street-address" required minlength="4" placeholder="Barrio, calle principal o referencia (Loja)" aria-describedby="ae-ubicacion" />
        <p class="campo__error" id="ae-ubicacion" data-error-for="ubicacion"></p>
      </div>
      <div class="campo">
        <label for="a-fecha">Día de la visita <span aria-hidden="true">*</span></label>
        <input id="a-fecha" name="fecha" type="date" required aria-describedby="ae-fecha" data-fecha />
        <p class="campo__error" id="ae-fecha" data-error-for="fecha"></p>
      </div>
      <div class="campo">
        <label for="a-hora">Hora <span aria-hidden="true">*</span></label>
        <select id="a-hora" name="hora" required aria-describedby="ae-hora">
          <option value="">Elige una hora</option>
          {horas.map((h) => <option value={h}>{h}</option>)}
        </select>
        <p class="campo__error" id="ae-hora" data-error-for="hora"></p>
      </div>
      <div class="campo">
        <label for="a-nombre">Tu nombre <span aria-hidden="true">*</span></label>
        <input id="a-nombre" name="nombre" type="text" autocomplete="name" required minlength="2" aria-describedby="ae-nombre" />
        <p class="campo__error" id="ae-nombre" data-error-for="nombre"></p>
      </div>
      <div class="campo">
        <label for="a-tel">WhatsApp o teléfono <span aria-hidden="true">*</span></label>
        <input id="a-tel" name="telefono" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9+\s\-()]{7,20}" placeholder="09…" aria-describedby="ae-tel" />
        <p class="campo__error" id="ae-tel" data-error-for="telefono"></p>
      </div>
      <div class="campo campo--ancho">
        <label for="a-correo">Correo <span class="opc">(opcional)</span></label>
        <input id="a-correo" name="correo" type="email" autocomplete="email" inputmode="email" aria-describedby="ae-correo" />
        <p class="campo__error" id="ae-correo" data-error-for="correo"></p>
      </div>
    </div>

    <div class="trampa" aria-hidden="true"><label>No llenar <input type="text" name="sitio_web" tabindex="-1" autocomplete="off" /></label></div>

    <div class="agenda__pie">
      <button type="submit" class="btn btn--primario" data-submit>
        <span class="form__spin" aria-hidden="true"></span><span data-submit-label>Agendar visita</span>
      </button>
      <p class="agenda__nota">Te confirmamos la cita por WhatsApp.</p>
    </div>
    <div class="form__estado" role="status" aria-live="polite" data-estado hidden></div>
  </form>
</dialog>

<style>
  .agenda {
    width: min(720px, calc(100% - 24px)); max-height: calc(100dvh - 24px);
    padding: 0; border: 0; border-radius: var(--r-l);
    background: var(--c-papel); color: var(--c-tinta);
    box-shadow: 0 40px 120px -30px rgb(0 0 0 / 0.6);
    overflow: auto;
  }
  .agenda::backdrop { background: color-mix(in oklab, var(--c-tinta) 70%, transparent); backdrop-filter: blur(4px); }
  @media (prefers-reduced-motion: no-preference) {
    .agenda[open] { animation: agenda-entra 380ms var(--ease-out); }
  }
  @keyframes agenda-entra { from { opacity: 0; transform: translateY(16px) scale(0.98); } }

  .agenda__form { display: grid; gap: 24px; padding: clamp(22px, 4vw, 40px); --focus: var(--c-verde); }
  .agenda__head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; }
  .agenda__head > div { display: grid; gap: 10px; }
  .agenda__head h2 { font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem); }
  .agenda__intro { color: var(--c-texto-suave); }
  .agenda__cerrar { flex: none; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--c-linea); background: var(--c-blanco); display: grid; place-items: center; cursor: pointer; transition: transform var(--dur-1); }
  .agenda__cerrar:hover { transform: rotate(90deg); }

  .agenda__grid { display: grid; gap: 18px 16px; }
  @media (min-width: 640px) { .agenda__grid { grid-template-columns: 1fr 1fr; } .campo--ancho { grid-column: 1 / -1; } }

  .campo { display: grid; gap: 8px; min-width: 0; }
  .campo label { font-size: 0.9375rem; font-weight: 500; }
  .opc { font-weight: 400; color: var(--c-texto-suave); }
  .campo input, .campo select {
    width: 100%; min-height: 52px; padding: 12px 16px; border-radius: 14px;
    border: 1.5px solid color-mix(in oklab, var(--c-tinta) 18%, transparent);
    background: var(--c-blanco); font-size: 1rem;
    transition: border-color var(--dur-1), box-shadow var(--dur-1);
  }
  .campo input:hover, .campo select:hover { border-color: color-mix(in oklab, var(--c-tinta) 35%, transparent); }
  .campo input:focus-visible, .campo select:focus-visible { outline: none; border-color: var(--c-verde); box-shadow: 0 0 0 4px color-mix(in oklab, var(--c-menta) 55%, transparent); }
  .campo [aria-invalid='true'] { border-color: var(--c-coral); }
  .campo__error { font-size: 0.8125rem; color: color-mix(in oklab, var(--c-coral) 50%, var(--c-tinta)); }
  .campo__error:empty { display: none; }
  .trampa { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .agenda__pie { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .agenda__nota { font-size: var(--t-small); color: var(--c-texto-suave); }
  .agenda .btn--primario { --btn-bg: var(--c-verde); --btn-fg: var(--c-blanco); }
  .agenda .btn--primario:hover { --btn-bg: color-mix(in oklab, var(--c-verde) 86%, var(--c-tinta)); }
  .agenda .btn--secundario { --btn-fg: var(--c-tinta); --btn-bd: color-mix(in oklab, var(--c-tinta) 28%, transparent); }
  .form__spin { display: none; width: 16px; height: 16px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent; animation: girar 700ms linear infinite; }
  .agenda__form.is-enviando .form__spin { display: inline-block; }
  @keyframes girar { to { transform: rotate(1turn); } }
  .form__estado { padding: 16px 18px; border-radius: 14px; font-size: 0.9375rem; display: grid; gap: 12px; }
  .form__estado[data-tipo='ok'] { background: color-mix(in oklab, var(--c-menta) 45%, var(--c-blanco)); }
  .form__estado[data-tipo='error'], .form__estado[data-tipo='pendiente'] { background: color-mix(in oklab, var(--c-coral) 18%, var(--c-blanco)); }
  .form__estado .acciones { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 639px) { .agenda__pie .btn { width: 100%; } }
</style>

<script>
  const dialogo = document.querySelector<HTMLDialogElement>('[data-agenda]');
  const form = document.querySelector<HTMLFormElement>('[data-agenda-form]');

  if (dialogo && form) {
    const endpoint = form.dataset.endpoint?.trim() ?? '';
    const key = form.dataset.key?.trim() ?? '';
    const whatsapp = (form.dataset.whatsapp ?? '').replace(/\D/g, '');
    const email = form.dataset.email?.trim() ?? '';
    const estado = form.querySelector<HTMLElement>('[data-estado]')!;
    const boton = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const etiqueta = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const fecha = form.querySelector<HTMLInputElement>('[data-fecha]')!;
    let origen: HTMLElement | null = null;

    // Fecha mínima: mañana (la visita necesita al menos un día de anticipación)
    const manana = new Date(); manana.setDate(manana.getDate() + 1);
    fecha.min = manana.toISOString().slice(0, 10);

    const abrir = (e: Event) => {
      origen = e.currentTarget as HTMLElement;
      estado.hidden = true;
      dialogo.showModal();
      form.querySelector<HTMLInputElement>('input[name="empresa"]')?.focus();
    };
    document.querySelectorAll<HTMLElement>('[data-abrir-agenda]').forEach((b) => b.addEventListener('click', abrir));
    dialogo.querySelector('[data-cerrar-agenda]')?.addEventListener('click', () => dialogo.close());
    dialogo.addEventListener('click', (e) => { if (e.target === dialogo) dialogo.close(); }); // clic fuera
    dialogo.addEventListener('close', () => origen?.focus());

    const MSG: Record<string, (el: HTMLInputElement | HTMLSelectElement) => string> = {
      empresa: () => 'Escribe el nombre de tu negocio.',
      giro: () => 'Cuéntanos a qué se dedica tu negocio.',
      ubicacion: () => 'Indica dónde está tu negocio para poder visitarte.',
      fecha: (el) => (el.validity.valueMissing ? 'Elige el día de la visita.' : 'Elige una fecha a partir de mañana.'),
      hora: () => 'Elige una hora.',
      nombre: () => 'Escribe tu nombre.',
      telefono: (el) => (el.validity.valueMissing ? 'Necesitamos un número para confirmar la cita.' : 'Usa solo números, espacios, +, guiones o paréntesis.'),
      correo: () => 'Revisa el correo: debe tener la forma nombre@dominio.com.',
    };
    const error = (name: string, txt: string) => { const p = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`); if (p) p.textContent = txt; };
    const campos = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name]:not([name="sitio_web"]), select[name]'));
    const validar = (el: HTMLInputElement | HTMLSelectElement) => {
      if (el instanceof HTMLInputElement) {
        el.setCustomValidity('');
        const n = el.value.trim().length;
        if (n > 0 && el.minLength > 0 && n < el.minLength) el.setCustomValidity('corto');
      }
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', String(!ok));
      error(el.name, ok ? '' : (MSG[el.name]?.(el) ?? 'Revisa este campo.'));
      return ok;
    };
    campos.forEach((el) => {
      el.addEventListener('blur', () => { if ((el as HTMLInputElement).value || el.required) validar(el); });
      el.addEventListener('input', () => { if (el.getAttribute('aria-invalid') === 'true') validar(el); });
    });

    const mostrar = (tipo: string, html: string) => { estado.dataset.tipo = tipo; estado.innerHTML = html; estado.hidden = false; };
    const cargando = (si: boolean) => {
      form.classList.toggle('is-enviando', si); boton.disabled = si; boton.setAttribute('aria-busy', String(si));
      etiqueta.textContent = si ? 'Enviando…' : 'Agendar visita';
    };
    const fechaLarga = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('es-EC', { weekday: 'long', day: 'numeric', month: 'long' });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      estado.hidden = true;
      const malos = campos.map(validar).filter((ok) => !ok).length;
      if (malos) {
        mostrar('error', `<p>Revisa ${malos === 1 ? 'el campo marcado' : `los ${malos} campos marcados`}.</p>`);
        form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        return;
      }
      if ((form.elements.namedItem('sitio_web') as HTMLInputElement)?.value) return;

      const d = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      delete d.sitio_web;
      const resumen = [
        'Hola PREDIR, quiero agendar un diagnóstico.',
        `Empresa: ${d.empresa} (${d.giro})`,
        `Ubicación: ${d.ubicacion}`,
        `Visita: ${fechaLarga(d.fecha)} a las ${d.hora}`,
        `Contacto: ${d.nombre} · ${d.telefono}${d.correo ? ' · ' + d.correo : ''}`,
      ].join('\n');

      if (!endpoint) {
        const t = encodeURIComponent(resumen);
        const acc: string[] = [];
        if (whatsapp) acc.push(`<a class="btn btn--primario" href="https://wa.me/${whatsapp}?text=${t}" target="_blank" rel="noopener">Enviar por WhatsApp</a>`);
        if (email) acc.push(`<a class="btn btn--secundario" href="mailto:${email}?subject=${encodeURIComponent('Agenda de diagnóstico')}&body=${t}">Enviar por correo</a>`);
        mostrar('pendiente', `<p><strong>Tu solicitud aún no se ha enviado.</strong> El envío automático al correo todavía no está conectado.${acc.length ? ' Envíala ahora con tus datos ya escritos:' : ''}</p>${acc.length ? `<div class="acciones">${acc.join('')}</div>` : ''}`);
        return;
      }

      cargando(true);
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            ...(key ? { access_key: key } : {}),
            subject: `Agenda de diagnóstico: ${d.empresa}`,
            from_name: 'Web PREDIR',
            tipo: 'Agenda de diagnóstico',
            ...d,
            fecha_legible: `${fechaLarga(d.fecha)} · ${d.hora}`,
            origen: location.href,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        campos.forEach((c) => c.removeAttribute('aria-invalid'));
        mostrar('ok', `<p><strong>¡Listo! Recibimos tu solicitud.</strong> Te escribiremos para confirmar la visita del ${fechaLarga(d.fecha)} a las ${d.hora}.</p>`);
      } catch {
        mostrar('error', '<p><strong>No pudimos enviar tu solicitud.</strong> Revisa tu conexión e inténtalo de nuevo.</p>');
      } finally {
        cargando(false);
      }
    });
  }
</script>
