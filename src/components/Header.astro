---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../config/site';
---
<header class="nav" data-nav>
  <div class="wrap nav__in">
    <a href="/" class="nav__logo" aria-label="Predir, ir al inicio">
      <Logo tono="blanco" alto={30} class="nav__logo-claro" eager />
      <Logo tono="color" alto={30} class="nav__logo-color" eager />
    </a>

    <nav class="nav__links" aria-label="Principal">
      <ul role="list">
        {nav.map((l) => <li><a href={l.href} class="link">{l.label}</a></li>)}
      </ul>
    </nav>

    <a href="/#contacto" class="btn btn--primario nav__cta">Solicitar propuesta</a>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-toggle>
      <span class="sr-only" data-menu-label>Abrir menú</span>
      <Icon name="menu" class="i-abrir" />
      <Icon name="close" class="i-cerrar" />
    </button>
  </div>

</header>

<!-- Menú móvil fuera del <header>: la cabecera usa backdrop-filter, que convertiría
     a este position:fixed en relativo a la barra de 72px y lo dejaría sin altura. -->
<div class="menu" id="menu-movil" data-menu hidden>
  <nav class="wrap" aria-label="Menú móvil">
    <ul role="list" class="menu__lista">
      {nav.map((l, i) => (
        <li style={`--i:${i}`}><a href={l.href} data-menu-link>{l.label}</a></li>
      ))}
    </ul>
    <a href="/#contacto" class="btn btn--primario menu__cta" data-menu-link>Solicitar propuesta</a>
  </nav>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto; z-index: 50;
    height: var(--nav-h);
    color: var(--c-blanco);
    transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out),
      box-shadow var(--dur-2) var(--ease-out);
  }
  .nav__in { height: 100%; display: flex; align-items: center; gap: 32px; }
  .nav__logo { display: inline-flex; flex: none; border-radius: 8px; }
  .nav__logo :global(img) { display: block; }
  :global(.nav__logo-color) { display: none; }

  .nav__links { margin-left: auto; display: none; }
  .nav__links ul { display: flex; gap: 32px; }
  .nav__links a { font-size: 0.9375rem; padding-block: 8px; }
  .nav__cta { display: none; min-height: 44px; padding: 0 20px; font-size: 0.9375rem; --btn-bg: var(--c-menta); --btn-fg: var(--c-tinta); }
  .nav__cta:hover { --btn-bg: var(--c-blanco); }

  .nav__toggle {
    margin-left: auto; width: 48px; height: 48px; display: grid; place-items: center;
    border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer;
  }
  .nav__toggle :global(.i-cerrar) { display: none; }
  .nav__toggle[aria-expanded='true'] :global(.i-cerrar) { display: block; }
  .nav__toggle[aria-expanded='true'] :global(.i-abrir) { display: none; }

  /* Estado sólido (tras pasar el hero o en páginas internas) */
  .nav.is-solido {
    background: color-mix(in oklab, var(--c-papel) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    color: var(--c-tinta);
    box-shadow: 0 1px 0 var(--c-linea);
  }
  .nav.is-solido :global(.nav__logo-claro) { display: none; }
  .nav.is-solido :global(.nav__logo-color) { display: block; }
  .nav.is-solido .nav__cta { --btn-bg: var(--c-verde); --btn-fg: var(--c-blanco); }
  .nav.is-solido .nav__cta:hover { --btn-bg: color-mix(in oklab, var(--c-verde) 86%, var(--c-tinta)); }

  .nav.is-oscuro {
    background: color-mix(in oklab, var(--c-tinta) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 var(--c-linea-osc);
  }

  /* Menú móvil a pantalla completa */
  .menu {
    position: fixed; inset: var(--nav-h) 0 0; z-index: 49; background: var(--c-tinta); color: var(--c-blanco);
    padding-top: 32px; overflow-y: auto;
  }
  .menu__lista { display: grid; gap: 4px; margin-bottom: 32px; }
  .menu__lista a {
    display: block; padding: 12px 0; text-decoration: none;
    font-family: var(--f-display); font-size: 2.25rem; letter-spacing: -0.02em; line-height: 1.1;
    border-bottom: 1px solid var(--c-linea-osc);
  }
  .menu__cta { width: 100%; --btn-bg: var(--c-menta); --btn-fg: var(--c-tinta); }
  @media (prefers-reduced-motion: no-preference) {
    .menu:not([hidden]) li { animation: entrar 520ms var(--ease-out) both; animation-delay: calc(var(--i) * 50ms); }
  }
  :global(html.menu-abierto) .nav { background: var(--c-tinta); color: var(--c-blanco); box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
  :global(html.menu-abierto) .nav :global(.nav__logo-claro) { display: block; }
  :global(html.menu-abierto) .nav :global(.nav__logo-color) { display: none; }
  :global(html.menu-abierto) { overflow: hidden; }

  @media (min-width: 1024px) {
    .nav__links { display: block; }
    .nav__cta { display: inline-flex; }
    .nav__toggle, .menu { display: none !important; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  // La cabecera adopta el tono de la sección que tiene debajo:
  // sobre el hero → transparente; sobre otra sección oscura → tinta translúcida; sobre clara → papel.
  if (nav) {
    const actualizar = () => {
      const y = nav.offsetHeight / 2;
      const bajo = document.elementsFromPoint(window.innerWidth / 2, y).find((el) => !nav.contains(el));
      const oscura = bajo?.closest('[data-hero], .section--osc, .on-dark');
      const enHero = !!bajo?.closest('[data-hero]') && window.scrollY < 8;
      nav.classList.toggle('is-oscuro', !!oscura && !enHero);
      nav.classList.toggle('is-solido', !oscura);
    };
    let pend = false;
    const onScroll = () => { if (!pend) { pend = true; requestAnimationFrame(() => { pend = false; actualizar(); }); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    actualizar();
  }

  function setMenu(abrir: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(abrir));
    if (label) label.textContent = abrir ? 'Cerrar menú' : 'Abrir menú';
    menu.hidden = !abrir;
    document.documentElement.classList.toggle('menu-abierto', abrir);
  }
  toggle?.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { setMenu(false); toggle.focus(); }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (m) => m.matches && setMenu(false));
</script>
