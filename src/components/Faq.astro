---
import Icon from './Icon.astro';
import { faq } from '../data/contenido';
---
<section class="section" id="preguntas" aria-labelledby="faq-titulo">
  <div class="wrap faq-grid">
    <header class="faq__head">
      <p class="label">Preguntas frecuentes</p>
      <h2 id="faq-titulo">Cómo cotizamos y cómo trabajamos</h2>
      <p class="sec-intro">¿Tu duda no está aquí? Escríbenos y la respondemos sin compromiso.</p>
    </header>
    <div class="faq">
      {faq.map((f) => (
        <details>
          <summary><span>{f.q}</span><Icon name="plus" class="faq__ico" /></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; gap: 40px; }
  .faq__head { display: grid; gap: 20px; align-content: start; }
  .faq details { border-top: 1px solid var(--c-linea); }
  .faq details:last-child { border-bottom: 1px solid var(--c-linea); }
  .faq summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px;
    padding: 24px 0; min-height: 44px;
    font-family: var(--f-display); font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.375rem); letter-spacing: -0.01em; line-height: 1.25;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover span { color: var(--c-verde); }
  .faq :global(.faq__ico) { flex: none; color: var(--c-verde); transition: transform var(--dur-2) var(--ease-out); }
  .faq details[open] :global(.faq__ico) { transform: rotate(45deg); }
  .faq details p { padding: 0 48px 28px 0; color: var(--c-texto-suave); max-width: 64ch; }
  @media (prefers-reduced-motion: no-preference) {
    .faq details[open] p { animation: entrar 400ms var(--ease-out); }
  }
  @media (min-width: 1024px) {
    .faq-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
    .faq__head { grid-column: 1 / span 5; }
    .faq { grid-column: 7 / -1; }
  }
</style>
