---
import Simbolo from './Simbolo.astro';
import Imagen from './Imagen.astro';
import Icon from './Icon.astro';
import { socios, mision } from '../data/contenido';
import { whatsappLink, telefonoLocal } from '../config/site';
const iniciales = (n: string) => n.split(' ').map((p) => p[0]).join('');
---
<section class="section section--alt" id="nosotros" aria-labelledby="nos-titulo">
  <div class="wrap">
    <header class="sec-head">
      <p class="label">Nosotros</p>
      <h2 id="nos-titulo">Código y diseño en un mismo equipo</h2>
      <p class="sec-intro">
        Somos Iván y Fabián. Desde Loja ayudamos a los negocios a dejar el papel y a verse tan profesionales como trabajan.
      </p>
    </header>

    <div class="filo">
      <figure class="filo__img">
        <Imagen nombre="nosotros-mesa-compartida" sizes="(min-width: 1024px) 50vw, 100vw" />
        <span class="filo__sello" aria-hidden="true"><Simbolo variante="color" size={44} /></span>
      </figure>
      <div class="filo__txt">
        <h3>Primero entendemos tu negocio. Después construimos.</h3>
        <p>Un sistema solo sirve si tu equipo lo entiende y lo usa. Por eso desarrollo y diseño trabajan juntos desde el primer día.</p>
        <ul role="list" class="filo__lista">
          <li><b>Claridad.</b> Sin tecnicismos: sabes qué hacemos y por qué.</li>
          <li><b>A tu medida.</b> El sistema se adapta a ti, no al revés.</li>
          <li><b>Cercanía.</b> Estamos en Loja y seguimos ahí después de entregar.</li>
        </ul>
      </div>
    </div>

    <ul role="list" class="socios">
      {socios.map((s) => (
        <li class={`socio socio--${s.mitad}`}>
          <div class="socio__foto">
            {s.foto ? (
              <img src={`${s.foto}-960.webp`} srcset={`${s.foto}-480.webp 480w, ${s.foto}-960.webp 960w`} sizes="(min-width: 1024px) 280px, (min-width: 768px) 45vw, 90vw" alt={`${s.nombre}, ${s.cargo} de Predir`} width="960" height="1200" loading="lazy" decoding="async" />
            ) : (
              <div class="socio__hueco" role="img" aria-label={`Fotografía de ${s.nombre} pendiente`}>
                <span class="socio__ini" aria-hidden="true">{iniciales(s.nombre)}</span>
                <span class="provisional">Fotografía pendiente</span>
              </div>
            )}
            <svg class="socio__mitad" viewBox="0 0 120 120" aria-hidden="true">
              {s.mitad === 'verde' ? (
                <g fill="currentColor"><rect x="26" y="60" width="16" height="56" rx="8" /><rect x="26" y="60" width="16" height="20" /><path d="M60 34 A26 26 0 0 0 60 86" fill="none" stroke="currentColor" stroke-width="16" /></g>
              ) : (
                <g fill="currentColor"><rect x="78" y="4" width="16" height="56" rx="8" /><rect x="78" y="40" width="16" height="20" /><path d="M60 86 A26 26 0 0 0 60 34" fill="none" stroke="currentColor" stroke-width="16" /></g>
              )}
            </svg>
          </div>
          <div class="socio__txt">
            <h3>{s.nombre}</h3>
            <p class="socio__cargo">{s.cargo}</p>
            <a class="socio__wa btn-wa" href={whatsappLink(`Hola ${s.nombre.split(' ')[0]}, quiero conversar sobre un proyecto con PREDIR.`, s.whatsapp)} target="_blank" rel="noopener" aria-label={`Escribir a ${s.nombre} por WhatsApp al ${telefonoLocal(s.whatsapp)}`}>
              <Icon name="whatsapp" size={18} /><span>{telefonoLocal(s.whatsapp)}</span>
            </a>
            <p>{s.bio}</p>
            <ul role="list" class="socio__enfoque" aria-label={`Enfoque de ${s.nombre}`}>
              {s.enfoque.map((e) => <li>{e}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ul>

    <div class="mv">
      <div class="mv__item">
        <p class="mv__t">Misión {mision.borrador && <span class="provisional">Borrador por validar</span>}</p>
        <p>{mision.mision}</p>
      </div>
      <div class="mv__item">
        <p class="mv__t">Visión {mision.borrador && <span class="provisional">Borrador por validar</span>}</p>
        <p>{mision.vision}</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Filosofía */
  .filo { display: grid; gap: 40px; align-items: center; margin-bottom: clamp(40px, 4vw, 64px); }
  .filo__img { position: relative; margin: 0; border-radius: var(--r-l); overflow: hidden; aspect-ratio: 3 / 2; background: var(--c-papel-2); }
  .filo__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .filo__img:hover :global(img) { transform: scale(1.025); }
  .filo__sello { position: absolute; left: 50%; bottom: 18px; translate: -50% 0; width: 72px; height: 72px; border-radius: 50%; display: grid; place-items: center; background: var(--c-blanco); box-shadow: 0 16px 32px -14px rgb(0 0 0 / 0.45); }
  .filo__txt { display: grid; gap: 18px; max-width: 62ch; }
  .filo__txt > p { color: var(--c-texto-suave); font-size: 1.0625rem; }
  .filo__lista { display: grid; gap: 10px; margin-top: 6px; }
  .filo__lista li { padding-left: 22px; position: relative; color: var(--c-texto-suave); }
  .filo__lista li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 10px; height: 10px; border-radius: 50%; background: var(--c-coral); }
  .filo__lista b { color: var(--c-tinta); font-weight: 500; }

  /* Socios */
  .socios { display: grid; gap: var(--col-gap); }
  .socio { display: grid; gap: 24px; padding: 16px 16px 28px; border-radius: var(--r-l); background: var(--c-papel); border: 1px solid var(--c-linea); }
  .socio__foto { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-m); overflow: hidden; background: var(--c-papel-2); }
  .socio__foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 600ms var(--ease-out); }
  .socio:hover .socio__foto img { transform: scale(1.025); }
  .socio__hueco { position: absolute; inset: 0; display: grid; place-items: center; align-content: center; gap: 16px; }
  .socio__ini { font-family: var(--f-display); font-size: clamp(4.5rem, 10vw, 7.5rem); letter-spacing: -0.04em; line-height: 1; color: color-mix(in oklab, var(--c-tinta) 18%, transparent); }
  /* La mitad del símbolo que corresponde a cada socio: la "p" (verde) y la "d" (coral) */
  .socio__mitad { position: absolute; z-index: 0; width: 92%; height: auto; bottom: -6%; pointer-events: none; transition: transform 900ms var(--ease-out); }
  .socio--verde .socio__mitad { left: -30%; color: color-mix(in oklab, var(--c-verde) 22%, transparent); }
  .socio--coral .socio__mitad { right: -30%; top: -6%; bottom: auto; color: color-mix(in oklab, var(--c-coral) 30%, transparent); }
  .socio--verde:hover .socio__mitad { transform: translateX(4%); }
  .socio--coral:hover .socio__mitad { transform: translateX(-4%); }
  .socio__hueco { z-index: 1; }
  .socio__foto img { position: relative; z-index: 1; }
  .socio__txt { display: grid; gap: 10px; padding-inline: 8px; }
  .socio__txt h3 { font-size: var(--t-h3); }
  .socio__cargo { font-family: var(--f-mono); font-size: var(--t-label); }
  .socio--verde .socio__cargo { color: var(--c-verde); }
  .socio--coral .socio__cargo { color: color-mix(in oklab, var(--c-coral) 55%, var(--c-tinta)); }
  .socio__txt > p:not(.socio__cargo) { color: var(--c-texto-suave); max-width: 48ch; }
  .socio__wa { justify-self: start; min-height: 44px; font-family: var(--f-mono); font-size: 0.875rem; }
  .socio__enfoque { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
  .socio__enfoque li { font-size: 0.8125rem; padding: 6px 12px; border-radius: var(--r-pill); background: var(--c-blanco); border: 1px solid var(--c-linea); }

  /* Misión y visión */
  .mv { display: grid; gap: var(--col-gap); margin-top: clamp(40px, 4vw, 64px); }
  .mv__item { display: grid; gap: 14px; padding-top: 24px; border-top: 3px solid var(--c-menta); }
  .mv__item:last-child { border-top-color: var(--c-coral); }
  .mv__t { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-family: var(--f-mono); font-size: var(--t-label); color: var(--c-texto-suave); }
  .mv__item > p:last-child { font-family: var(--f-display); font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem); line-height: 1.3; letter-spacing: -0.015em; max-width: 34ch; }

  @media (min-width: 768px) {
    .socios, .mv { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .filo { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
    .filo__img { grid-column: 1 / span 6; }
    .filo__txt { grid-column: 8 / -1; }
    .socio { grid-template-columns: 5fr 6fr; align-items: center; padding: 16px; }
    .socio__txt { padding: 16px 16px 16px 8px; }
  }
</style>
