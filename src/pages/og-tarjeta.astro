---
/**
 * Plantilla para generar /public/og.png (1200×630). No se indexa.
 * Regenerar: abrir /og-tarjeta a 1200×630 y capturar (ver docs/04-ARQUITECTURA.md).
 */
import '../styles/global.css';
---
<!doctype html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Tarjeta OG · Predir</title>
  </head>
  <body>
    <div class="og">
      <svg class="og__arcos" viewBox="0 0 120 120" aria-hidden="true"><path d="M60 34 A26 26 0 0 0 60 86" /><path d="M60 86 A26 26 0 0 0 60 34" /></svg>
      <img class="og__logo" src="/brand/logo-horizontal-blanco-recorte.png" alt="Predir" width="226" height="64" />
      <p class="og__t">Lo que hoy haces <span>a&nbsp;mano</span>, mañana lo hace <em>tu&nbsp;sistema</em>.</p>
      <p class="og__s">Software a medida · Automatización · Identidad visual — Loja, Ecuador</p>
    </div>
  </body>
</html>

<style>
  body { margin: 0; background: var(--c-tinta); }
  .og { position: relative; width: 1200px; height: 630px; overflow: hidden; background: var(--c-tinta); color: var(--c-blanco); padding: 72px 80px; box-sizing: border-box; display: flex; flex-direction: column; }
  .og::before { content: ''; position: absolute; inset: 0; background-image: radial-gradient(color-mix(in oklab, var(--c-menta) 22%, transparent) 1px, transparent 1.4px); background-size: 28px 28px; mask-image: radial-gradient(90% 90% at 80% 40%, #000 20%, transparent 70%); }
  .og__arcos { position: absolute; width: 1300px; right: -560px; top: -330px; fill: none; stroke-width: 0.5; }
  .og__arcos path:first-child { stroke: color-mix(in oklab, var(--c-menta) 40%, transparent); }
  .og__arcos path:last-child { stroke: color-mix(in oklab, var(--c-coral) 45%, transparent); }
  .og__logo { position: relative; align-self: flex-start; height: 56px; width: auto; }
  .og__t { position: relative; margin-top: auto; font-family: var(--f-display); font-weight: 500; font-size: 68px; line-height: 1.02; letter-spacing: -0.035em; max-width: 820px; }
  .og__t span { color: var(--c-coral); } .og__t em { font-style: normal; color: var(--c-menta); }
  .og__s { position: relative; margin-top: 28px; font-family: var(--f-mono); font-size: 20px; color: var(--c-texto-osc-suave); }
</style>
