---
/**
 * Manual de identidad visual de Predir (v0.1).
 * Construido con los archivos reales de Predir-Logo. Lo que no existía se marca como
 * "propuesta" (decisión de diseño a validar) o "pendiente" (información que falta).
 */
import Base from '../layouts/Base.astro';
import Simbolo from '../components/Simbolo.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';

const colores = [
  { id: 'verde', nombre: 'Verde Predir', hex: '#2F6D5F', rgb: '47 · 109 · 95', hsl: '166° 40% 31%', rol: 'Primario. Botones, enlaces, titulares de acento y fondos de marca.', fg: '#FFFFFF' },
  { id: 'coral', nombre: 'Coral', hex: '#E8836B', rgb: '232 · 131 · 107', hsl: '12° 73% 66%', rol: 'Acento. Mitad "d" del símbolo, alertas, detalles. Nunca como texto sobre claro.', fg: '#18282A' },
  { id: 'menta', nombre: 'Verde claro', hex: '#9FD3C5', rgb: '159 · 211 · 197', hsl: '164° 37% 73%', rol: 'Primario sobre fondos oscuros. Superficies suaves y datos.', fg: '#18282A' },
  { id: 'tinta', nombre: 'Tinta', hex: '#18282A', rgb: '24 · 40 · 42', hsl: '187° 27% 13%', rol: 'Texto principal, palabra "predir" y fondos oscuros.', fg: '#FFFFFF' },
];

const contrastes = [
  ['Tinta sobre blanco', '15,26 : 1', 'AAA', '#18282A', '#FFFFFF'],
  ['Verde sobre blanco', '6,05 : 1', 'AA', '#2F6D5F', '#FFFFFF'],
  ['Blanco sobre verde', '6,05 : 1', 'AA', '#FFFFFF', '#2F6D5F'],
  ['Verde claro sobre tinta', '9,16 : 1', 'AAA', '#9FD3C5', '#18282A'],
  ['Coral sobre tinta', '5,73 : 1', 'AA', '#E8836B', '#18282A'],
  ['Tinta sobre coral', '5,73 : 1', 'AA', '#18282A', '#E8836B'],
  ['Coral sobre blanco', '2,66 : 1', 'Solo decorativo', '#E8836B', '#FFFFFF'],
  ['Verde claro sobre blanco', '1,67 : 1', 'Solo decorativo', '#9FD3C5', '#FFFFFF'],
];

const variantes = [
  { archivo: 'simbolo-color.svg', v: 'color', fondo: '#FFFFFF', uso: 'Fondos claros (uso principal)' },
  { archivo: 'simbolo-para-fondo-oscuro.svg', v: 'oscuro', fondo: '#18282A', uso: 'Fondos oscuros' },
  { archivo: 'simbolo-blanco.svg', v: 'blanco', fondo: '#2F6D5F', uso: 'Fondo verde' },
  { archivo: 'simbolo-un-color-verde.svg', v: 'verde', fondo: '#FFFFFF', uso: 'Una tinta: sellos, grabados' },
  { archivo: 'simbolo-un-color-blanco.svg', v: 'blanco-1', fondo: '#2F6D5F', uso: 'Una tinta sobre color' },
] as const;

const incorrectos = [
  { t: 'No rotar', s: 'transform: rotate(-24deg)' },
  { t: 'No deformar', s: 'transform: scaleX(1.45)' },
  { t: 'No cambiar los colores', s: 'filter: hue-rotate(150deg)' },
  { t: 'No añadir sombras ni efectos', s: 'filter: drop-shadow(6px 8px 0 #18282A)' },
  { t: 'No usar sobre fondos sin contraste', s: '', fondo: '#9FD3C5' },
  { t: 'No invertir las mitades', s: 'transform: scaleX(-1)' },
];

const iconos = ['box', 'folders', 'chart', 'repeat', 'device', 'pen', 'code', 'compass', 'mail', 'pin', 'clock', 'check', 'arrow', 'plus', 'image', 'user'];

const tipos = [
  { nivel: 'Display / H1', fam: 'Bricolage Grotesque', peso: '500', tam: '76 / 40 px', lh: '1,0', tr: '−3,5 %', ej: 'Lo manual, digital', cls: 't-h1' },
  { nivel: 'H2 · Sección', fam: 'Bricolage Grotesque', peso: '500', tam: '52 / 32 px', lh: '1,04', tr: '−2,5 %', ej: 'Cómo trabajamos', cls: 't-h2' },
  { nivel: 'H3 · Tarjeta', fam: 'Bricolage Grotesque', peso: '500', tam: '28 / 22 px', lh: '1,15', tr: '−1,5 %', ej: 'Sistemas de gestión', cls: 't-h3' },
  { nivel: 'Entradilla', fam: 'Geist', peso: '400', tam: '21 / 18 px', lh: '1,55', tr: '0', ej: 'Convertimos procesos manuales en sistemas.', cls: 't-lead' },
  { nivel: 'Texto', fam: 'Geist', peso: '400', tam: '16 px', lh: '1,625', tr: '0', ej: 'Visitamos tu negocio y vemos cómo se trabaja hoy.', cls: 't-body' },
  { nivel: 'Etiqueta técnica', fam: 'Geist Mono', peso: '500', tam: '13 px', lh: '1,4', tr: '+2 %', ej: '01 · Ordenar', cls: 't-mono' },
];
---
<Base title="Manual de identidad visual" description="Manual de identidad visual de Predir: logotipo, colores, tipografía, elementos gráficos, componentes y movimiento." interna>
  <article class="manual">
    <!-- Portada -->
    <header class="m-portada on-dark">
      <div class="wrap m-portada__in">
        <p class="label">Manual de identidad visual · v0.1 · noviembre 2026</p>
        <h1>predir</h1>
        <p class="m-portada__sub">Cómo se ve, cómo suena y cómo se mueve la marca. Referencia para el sitio web y para todos los proyectos futuros.</p>
        <div class="m-leyenda">
          <span><i class="dot dot--ok"></i>Dato de la marca (archivos originales)</span>
          <span><i class="dot dot--prop"></i>Propuesta de diseño, a validar</span>
          <span><i class="dot dot--pend"></i>Información pendiente</span>
        </div>
        <nav class="m-indice" aria-label="Índice del manual">
          <ol role="list">
            {['Presentación', 'Concepto y personalidad', 'Logotipo', 'Usos incorrectos', 'Color', 'Tipografía', 'Elementos gráficos', 'Iconografía', 'Fotografía', 'Aplicaciones digitales', 'Componentes', 'Movimiento', 'Pendientes'].map((t, i) => (
              <li><a class="link" href={`#m${i + 1}`}><span>{String(i + 1).padStart(2, '0')}</span>{t}</a></li>
            ))}
          </ol>
        </nav>
      </div>
      <div class="m-portada__simbolo" aria-hidden="true"><Simbolo variante="oscuro" size="100%" /></div>
    </header>

    <!-- 01 Presentación -->
    <section class="m-sec" id="m1">
      <div class="wrap m-grid">
        <div class="m-head"><p class="m-num">01</p><h2>Presentación</h2></div>
        <div class="m-body">
          <p class="m-lead">Predir es un estudio de soluciones tecnológicas de Loja, Ecuador, fundado por Iván González (desarrollo de software) y Fabián Galarza (diseño y línea gráfica).</p>
          <p>Su trabajo consiste en identificar los procesos que un negocio todavía hace a mano y convertirlos en herramientas digitales: sistemas de gestión, automatizaciones, plataformas web y aplicaciones. A eso se suma la creación de identidades visuales.</p>
          <p>Este manual reúne lo que existe hoy de la marca (los archivos de la carpeta <code>Predir-Logo</code>) y las decisiones tomadas para llevarla al entorno digital. Cada decisión nueva está marcada para que los socios la validen.</p>
        </div>
      </div>
    </section>

    <!-- 02 Concepto -->
    <section class="m-sec m-sec--alt" id="m2">
      <div class="wrap m-grid">
        <div class="m-head"><p class="m-num">02</p><h2>Concepto y personalidad</h2><span class="tag tag--prop">Propuesta</span></div>
        <div class="m-body">
          <p class="m-lead">Una lectura del símbolo: una <b>p</b> y una <b>d</b> que comparten el mismo anillo. Dos trazos distintos que, juntos, forman una sola figura.</p>
          <p>De ahí sale el concepto que proponemos para comunicar: <b>dos oficios, un mismo trazo</b>. Desarrollo y diseño trabajando como una sola pieza, del mismo modo que la empresa une lo manual con lo digital.</p>
          <p class="nota"><span class="tag tag--pend">Pendiente</span> Confirmar con Fabián el significado original del símbolo, de sus dos colores y del nombre "Predir".</p>
          <ul role="list" class="rasgos">
            <li><b>Claro</b><span>Explica sin tecnicismos. Dice qué hace y para quién.</span></li>
            <li><b>Preciso</b><span>Cuida el detalle: retícula, alineaciones, datos correctos.</span></li>
            <li><b>Cercano</b><span>Habla de tú, conoce Loja y acompaña después de entregar.</span></li>
            <li><b>Creativo</b><span>Resuelve con criterio propio, no con plantillas.</span></li>
          </ul>
          <div class="voz">
            <div><p class="voz__t">Así sí</p><p>"Tu inventario, al día y desde el celular."</p></div>
            <div><p class="voz__t voz__t--no">Así no</p><p>"Soluciones innovadoras que llevan tu negocio al siguiente nivel."</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Logotipo -->
    <section class="m-sec" id="m3">
      <div class="wrap">
        <div class="m-grid">
          <div class="m-head"><p class="m-num">03</p><h2>Logotipo</h2><span class="tag tag--ok">De la marca</span></div>
          <div class="m-body">
            <p class="m-lead">El logotipo se compone del símbolo y la palabra <b>predir</b> en minúsculas. El símbolo puede usarse solo cuando el nombre ya está presente o el espacio es reducido (favicon, íconos de app, avatares).</p>
          </div>
        </div>

        <div class="logo-pares">
          <figure class="lienzo lienzo--claro"><Logo tono="color" alto={72} /><figcaption>Horizontal · color · <code>logo-horizontal-color.png</code></figcaption></figure>
          <figure class="lienzo lienzo--osc"><Logo tono="blanco" alto={72} /><figcaption>Horizontal · blanco · <code>logo-horizontal-blanco.png</code></figcaption></figure>
        </div>

        <h3 class="m-h3">Anatomía del símbolo</h3>
        <div class="anatomia">
          <figure class="lienzo lienzo--claro anatomia__fig">
            <div class="anatomia__dib">
              <svg class="anatomia__guias" viewBox="0 0 120 120" aria-hidden="true">
                <rect x="0.25" y="0.25" width="119.5" height="119.5" />
                <path d="M26 0V120 M42 0V120 M78 0V120 M94 0V120 M0 60H120 M60 0V120" />
                <circle cx="60" cy="60" r="34" /><circle cx="60" cy="60" r="18" />
              </svg>
              <Simbolo variante="color" size="100%" />
            </div>
            <figcaption>Retícula de 120 × 120 unidades (archivos SVG originales)</figcaption>
          </figure>
          <dl class="medidas">
            <div><dt>Trazo</dt><dd>16 u, terminales redondeados (radio 8 u)</dd></div>
            <div><dt>Anillo</dt><dd>Radio medio 26 u: exterior 34 u, interior 18 u</dd></div>
            <div><dt>Asta "p"</dt><dd>Desciende de y = 60 a y = 116, a la izquierda</dd></div>
            <div><dt>Asta "d"</dt><dd>Asciende de y = 4 a y = 60, a la derecha</dd></div>
            <div><dt>División</dt><dd>Vertical exacta en x = 60: mitad izquierda verde, derecha coral</dd></div>
            <div><dt>Simetría</dt><dd>Rotación de 180° entre la "p" y la "d"</dd></div>
          </dl>
        </div>

        <h3 class="m-h3">Variantes oficiales del símbolo</h3>
        <ul role="list" class="variantes">
          {variantes.map((v) => (
            <li>
              <div class="variantes__lienzo" style={`background:${v.fondo}`}><Simbolo variante={v.v} size={88} /></div>
              <p>{v.uso}</p>
              <code>{v.archivo}</code>
            </li>
          ))}
          <li>
            <div class="variantes__lienzo" style="background:#F4F8F7"><img src="/brand/icono-app-verde.svg" width="88" height="88" alt="Ícono de app de Predir" style="border-radius:20px" /></div>
            <p>Ícono de app (fondo #2F6D5F)</p>
            <code>icono-app-verde.svg</code>
          </li>
        </ul>

        <div class="m-cols">
          <div>
            <h3 class="m-h3">Área de protección <span class="tag tag--prop">Propuesta</span></h3>
            <figure class="lienzo lienzo--claro proteccion">
              <div class="proteccion__caja"><Logo tono="color" alto={56} /></div>
              <figcaption>Margen mínimo = alto de la letra "p" del símbolo (≈ ⅓ de la altura del logotipo) en los cuatro lados.</figcaption>
            </figure>
          </div>
          <div>
            <h3 class="m-h3">Tamaños mínimos <span class="tag tag--prop">Propuesta</span></h3>
            <div class="minimos">
              <div><Logo tono="color" alto={24} /><p>Horizontal: 24 px de alto en pantalla · 25 mm de ancho impreso</p></div>
              <div><Simbolo variante="color" size={16} /><p>Símbolo: 16 px (existe <code>favicon-16.png</code>)</p></div>
            </div>
            <p class="nota"><span class="tag tag--pend">Pendiente</span> El logotipo horizontal solo existe en PNG. Se necesita la versión vectorial (SVG/AI) y el nombre de su tipografía.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 Usos incorrectos -->
    <section class="m-sec m-sec--alt" id="m4">
      <div class="wrap">
        <div class="m-grid">
          <div class="m-head"><p class="m-num">04</p><h2>Usos incorrectos</h2></div>
          <div class="m-body"><p class="m-lead">El símbolo se usa siempre tal como está en los archivos originales. Estos son los errores más comunes.</p></div>
        </div>
        <ul role="list" class="mal">
          {incorrectos.map((m) => (
            <li>
              <div class="mal__lienzo" style={m.fondo ? `background:${m.fondo}` : undefined}>
                <div style={m.s}><Simbolo variante="color" size={96} /></div>
                <span class="mal__x" aria-hidden="true"><Icon name="close" size={18} /></span>
              </div>
              <p>{m.t}</p>
            </li>
          ))}
        </ul>
        <p class="nota">Tampoco: contornear el símbolo, separar sus mitades, cambiar el orden símbolo-palabra, reescribir "predir" con otra tipografía o en mayúsculas.</p>
      </div>
    </section>

    <!-- 05 Color -->
    <section class="m-sec" id="m5">
      <div class="wrap">
        <div class="m-grid">
          <div class="m-head"><p class="m-num">05</p><h2>Color</h2><span class="tag tag--ok">De la marca</span></div>
          <div class="m-body"><p class="m-lead">Cuatro colores corporativos, definidos en el archivo <code>LEEME.txt</code> de la carpeta de marca. No se agregan colores nuevos: cualquier tono adicional se obtiene mezclándolos.</p></div>
        </div>
        <ul role="list" class="paleta">
          {colores.map((c) => (
            <li class="color">
              <div class="color__mues" style={`background:${c.hex};color:${c.fg}`}>
                <span>{c.nombre}</span>
                <button type="button" class="color__copiar" data-copiar={c.hex} aria-label={`Copiar ${c.hex}`}>{c.hex}</button>
              </div>
              <dl>
                <div><dt>HEX</dt><dd>{c.hex}</dd></div>
                <div><dt>RGB</dt><dd>{c.rgb}</dd></div>
                <div><dt>HSL</dt><dd>{c.hsl}</dd></div>
                <div><dt>CMYK</dt><dd><span class="tag tag--pend">Pendiente</span></dd></div>
              </dl>
              <p>{c.rol}</p>
            </li>
          ))}
        </ul>

        <div class="m-cols">
          <div>
            <h3 class="m-h3">Proporción de uso <span class="tag tag--prop">Propuesta</span></h3>
            <div class="proporcion" aria-hidden="true">
              <span style="flex:44;background:#F4F8F7;color:#18282A">Papel 44%</span>
              <span style="flex:26;background:#18282A">Tinta 26%</span>
              <span style="flex:16;background:#2F6D5F">Verde 16%</span>
              <span style="flex:9;background:#9FD3C5;color:#18282A">9%</span>
              <span style="flex:5;background:#E8836B;color:#18282A">5%</span>
            </div>
            <p class="nota">El coral es el acento: poco y en el lugar justo. "Papel" es un derivado (9% verde claro + blanco) para fondos amplios.</p>
          </div>
          <div>
            <h3 class="m-h3">Contraste (WCAG 2.2)</h3>
            <table class="contraste">
              <thead><tr><th scope="col">Combinación</th><th scope="col">Ratio</th><th scope="col">Uso</th></tr></thead>
              <tbody>
                {contrastes.map(([n, r, u, fg, bg]) => (
                  <tr><td><span class="contraste__mues" style={`color:${fg};background:${bg}`}>Aa</span>{n}</td><td class="mono">{r}</td><td>{u}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 Tipografía -->
    <section class="m-sec m-sec--alt" id="m6">
      <div class="wrap">
        <div class="m-grid">
          <div class="m-head"><p class="m-num">06</p><h2>Tipografía</h2><span class="tag tag--prop">Propuesta</span></div>
          <div class="m-body">
            <p class="m-lead">La palabra "predir" del logotipo usa una sans geométrica de terminaciones redondas. Para textos digitales proponemos una familia con la misma geometría, pero con más carácter en titulares.</p>
            <p class="nota"><span class="tag tag--pend">Pendiente</span> Identificar la tipografía exacta del logotipo (se parece a Poppins SemiBold, sin confirmar). El logotipo nunca se reescribe: se usa siempre el archivo.</p>
          </div>
        </div>
        <ul role="list" class="familias">
          <li><p class="familias__mues" style="font-family:var(--f-display)">Aa</p><b>Bricolage Grotesque</b><span>Titulares · 500 · óptica variable · Google Fonts (OFL)</span></li>
          <li><p class="familias__mues" style="font-family:var(--f-texto)">Aa</p><b>Geist</b><span>Texto e interfaz · 400 / 500 · Google Fonts (OFL)</span></li>
          <li><p class="familias__mues" style="font-family:var(--f-mono)">Aa</p><b>Geist Mono</b><span>Etiquetas, datos, código · 500 · Google Fonts (OFL)</span></li>
        </ul>
        <h3 class="m-h3">Jerarquía (escritorio / móvil)</h3>
        <div class="jerarquia">
          {tipos.map((t) => (
            <div class="jerarquia__fila">
              <p class={`jerarquia__ej ${t.cls}`}>{t.ej}</p>
              <dl>
                <div><dt>Nivel</dt><dd>{t.nivel}</dd></div>
                <div><dt>Familia</dt><dd>{t.fam} {t.peso}</dd></div>
                <div><dt>Tamaño</dt><dd>{t.tam}</dd></div>
                <div><dt>Interlínea · tracking</dt><dd>{t.lh} · {t.tr}</dd></div>
              </dl>
            </div>
          ))}
        </div>
        <p class="nota">Reglas: titulares en peso 500, nunca negrita gruesa; frases en minúscula inicial (no Title Case); líneas de texto de 45 a 70 caracteres; nunca menos de 13 px.</p>
      </div>
    </section>

    <!-- 07 Elementos gráficos -->
    <section class="m-sec" id="m7">
      <div class="wrap">
        <div class="m-grid">
          <div class="m-head"><p class="m-num">07</p><h2>Elementos gráficos</h2><span class="tag tag--prop">Propuesta</span></div>
          <div class="m-body"><p class="m-lead">Todos salen de la geometría del símbolo. Ninguno es decoración suelta: cada uno tiene un trabajo.</p></div>
        </div>
        <ul role="list" class="elementos">
          <li>
            <div class="elem elem--osc"><svg viewBox="0 0 120 120" class="elem__anillo" aria-hidden="true"><path d="M60 34 A26 26 0 0 0 60 86" /><path d="M60 86 A26 26 0 0 0 60 34" /></svg></div>
            <b>Anillo partido</b><span>El aro del símbolo, a gran escala y con trazo fino, como fondo de portadas y héroes.</span>
          </li>
          <li>
            <div class="elem"><span class="elem__trazo"></span><span class="elem__trazo elem__trazo--c"></span></div>
            <b>Trazo redondeado</b><span>Barras con terminales redondos (proporción 1:3,5 del asta). Pistas de progreso, niveles y separadores de acento.</span>
          </li>
          <li>
            <div class="elem"><span class="label">Etiqueta de sección</span></div>
            <b>Etiqueta bicolor</b><span>Pastilla verde + coral delante de cada etiqueta de sección: el símbolo reducido a una línea.</span>
          </li>
          <li>
            <div class="elem elem--puntos"></div>
            <b>Retícula de puntos</b><span>Papel técnico en verde claro al 20%. Solo en fondos oscuros, con máscara que se desvanece.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- 08 Iconografía -->
    <section class="m-sec m-sec--alt" id="m8">
      <div class="wrap">
        <div class="m-grid">
          <div class="m-head"><p class="m-num">08</p><h2>Iconografía</h2><span class="tag tag--prop">Propuesta</span></div>
          <div class="m-body"><p class="m-lead">Íconos lineales en retícula de 24 × 24, trazo de 2 px, terminales y uniones redondeadas: el mismo lenguaje del símbolo. Un solo color por ícono (verde sobre claro, verde claro sobre oscuro).</p></div>
        </div>
        <ul role="list" class="iconos">
          {iconos.map((n) => <li><Icon name={n} size={28} /><code>{n}</code></li>)}
        </ul>
        <p class="nota">Los logotipos de terceros (p. ej. WhatsApp) se usan con su forma oficial, nunca redibujados. El set completo vive en <code>src/components/Icon.astro</code>.</p>
      </div>
    </section>

    <!-- 09 Fotografía -->
    <section class="m-sec" id="m9">
      <div class="wrap m-grid">
        <div class="m-head"><p class="m-num">09</p><h2>Estilo fotográfico</h2><span class="tag tag--pend">Pendiente</span></div>
        <div class="m-body">
          <p class="m-lead">Todavía no hay fotografías de la marca. Cuando se produzcan, proponemos estas pautas:</p>
          <ul role="list" class="pautas">
            <li><Icon name="check" size={20} /><span><b>Personas reales</b> trabajando: los socios, clientes en su negocio (con permiso). Nada de stock con poses de oficina.</span></li>
            <li><Icon name="check" size={20} /><span><b>Luz natural</b>, tonos cálidos y neutros; que los verdes y el coral de la marca aparezcan en el entorno, no por filtro.</span></li>
            <li><Icon name="check" size={20} /><span><b>Loja como escenario:</b> locales, bodegas, mostradores, talleres. El "antes" de un proceso es una buena foto.</span></li>
            <li><Icon name="check" size={20} /><span><b>Retratos de los socios</b> en 4:5, mismo fondo y misma luz para ambos, mirada a cámara, plano medio.</span></li>
            <li><Icon name="check" size={20} /><span><b>Capturas reales</b> de los sistemas construidos (con datos ficticios o anonimizados) en lugar de ilustraciones.</span></li>
          </ul>
