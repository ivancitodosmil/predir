  .campo-demo input { min-height: 52px; padding: 14px 16px; border-radius: 14px; border: 1.5px solid color-mix(in oklab, var(--c-tinta) 18%, transparent); background: var(--c-blanco); font-weight: 400; }
  .campo-demo input:focus-visible { outline: none; border-color: var(--c-verde); box-shadow: 0 0 0 4px color-mix(in oklab, var(--c-menta) 55%, transparent); }

  .pend { display: grid; gap: 10px; }
  .pend li { padding: 14px 18px; border-radius: var(--r-m); background: color-mix(in oklab, var(--c-coral) 12%, var(--c-blanco)); border-left: 4px solid var(--c-coral); }

  @media print {
    :global(.nav), :global(.pie), :global(.skip) { display: none !important; }
    .m-sec { break-inside: avoid-page; padding: 32px 0; }
    .m-portada { padding-top: 48px; }
    .color__copiar { border: 0; padding: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    const original = b.textContent;
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copiar!);
        b.textContent = 'Copiado';
        setTimeout(() => (b.textContent = original), 1400);
      } catch { /* sin portapapeles: no hacer nada */ }
    });
  });
</script>
