# Copia este archivo como .env y completa cuando tengas los datos reales.
# Todas son públicas (se incrustan en el HTML), no pongas secretos aquí.

# WhatsApp comercial, formato internacional sin "+": 5939XXXXXXXX
PUBLIC_WHATSAPP=

# Correo comercial
PUBLIC_EMAIL=

# Endpoint que recibe el formulario de contacto por POST (JSON).
# Ejemplos: https://formspree.io/f/xxxxxx  ·  https://api.web3forms.com/submit (requiere access_key)
PUBLIC_FORM_ENDPOINT=

# Clave pública de Web3Forms (recibe los formularios en el correo). Ver docs/05-CORREO-CORPORATIVO.md
# Si la usas, pon también: PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_ACCESS_KEY=
